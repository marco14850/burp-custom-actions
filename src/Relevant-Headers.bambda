name: Relevant Headers
function: CUSTOM_ACTION
location: REPEATER
source: |+
    logging.logToOutput("=== CA: Relevant Headers ===");
    var original = requestResponse.request();
    // Optional regex for known volatile fields; empty means exact comparison.
    String volatilePattern = "";
    java.util.function.Function<String, String> normalize = text ->
        volatilePattern.isEmpty() ? text : text.replaceAll(volatilePattern, "<volatile>");
    try {
        var baseline = api.http().sendRequest(original).response();
        var control = api.http().sendRequest(original).response();
        if (baseline == null || control == null) {
            logging.logToOutput("Inconclusive: baseline response unavailable.");
            return;
        }
        java.util.function.Predicate<HttpResponse> equivalent = response -> response != null
            && response.statusCode() == baseline.statusCode()
            && java.util.Objects.equals(response.headerValue("Content-Type"), baseline.headerValue("Content-Type"))
            && java.util.Objects.equals(response.headerValue("Location"), baseline.headerValue("Location"))
            && normalize.apply(response.bodyToString()).equals(normalize.apply(baseline.bodyToString()));
        if (!equivalent.test(control)) {
            logging.logToOutput("Inconclusive: baseline is unstable. Configure volatilePattern for known dynamic fields.");
            return;
        }
        var current = original;

        var protectedNames = java.util.Set.of("host", "content-type", "content-encoding", "content-length", "transfer-encoding", "connection", "upgrade",
            ":method", ":scheme", ":authority", ":path", "accept-encoding", "te", "trailer", "keep-alive", "cookie");
        int deleted = 0;
        int replaceable = 0;
        int valueSensitive = 0;
        int inconclusive = 0;
        var tested = new java.util.HashSet<String>();
        for (var header : original.headers()) {
            var name = header.name().toLowerCase(java.util.Locale.ROOT);
            if (protectedNames.contains(name) || !tested.add(name)) continue;
            try {
                // Test every occurrence of a header name together, case-insensitively.
                var matching = new java.util.ArrayList<burp.api.montoya.http.message.HttpHeader>();
                boolean alreadyA = true;
                for (var existing : current.headers()) {
                    if (existing.name().equalsIgnoreCase(header.name())) {
                        matching.add(existing);
                        if (!existing.value().equals("a")) alreadyA = false;
                    }
                }
                var withoutHeader = current.withRemovedHeaders(matching);
                var candidate = withoutHeader;
                var deletionResponse = api.http().sendRequest(candidate).response();
                if (deletionResponse == null) {
                    inconclusive++;
                    logging.logToOutput("[Header " + header.name() + "] Inconclusive: no response without header; original retained."); continue;
                }
                if (equivalent.test(deletionResponse)) {
                    current = candidate;
                    deleted++;
                    logging.logToOutput("[Header " + header.name() + "] Not required in this reduction: removed."); continue;
                }
                String testValue = alreadyA ? "b" : "a";
                for (var existing : matching) {
                    candidate = candidate.withAddedHeader(burp.api.montoya.http.message.HttpHeader.httpHeader(existing.name(), testValue));
                }
                var modifiedResponse = api.http().sendRequest(candidate).response();
                if (modifiedResponse == null) {
                    inconclusive++;
                    logging.logToOutput("[Header " + header.name() + "] Presence required; value test inconclusive (no response). Original retained.");
                } else if (equivalent.test(modifiedResponse)) {
                    current = candidate;
                    replaceable++;
                    logging.logToOutput("[Header " + header.name() + "] Presence required; replacement value '" + testValue + "' accepted and retained.");
                } else {
                    valueSensitive++;
                    logging.logToOutput("[Header " + header.name() + "] Presence required; replacement value '" + testValue + "' changes the response. Original retained (value-sensitive).");
                }
            } catch (Exception e) {
                inconclusive++;
                logging.logToOutput("[Header " + header.name() + "] Inconclusive: probe error (" + e.getClass().getSimpleName() + "); original retained.");
            }
        }

        var cookies = new java.util.ArrayList<String>();
        var cookieHeaders = new java.util.ArrayList<burp.api.montoya.http.message.HttpHeader>();
        var names = new java.util.LinkedHashSet<String>();
        for (var header : current.headers()) {
            if (header.name().equalsIgnoreCase("Cookie")) {
                cookieHeaders.add(header);
                for (String cookie : header.value().split(";")) {
                    if (!cookie.trim().isEmpty()) {
                        cookies.add(cookie.trim());
                        names.add(cookie.trim().split("=", 2)[0]);
                    }
                }
            }
        }

        // Keep the reduced headers while rebuilding cookies; preserve the original binary body.
        // Remove every Cookie header instance, including mixed-case and duplicate headers.
        var withoutCookies = current.withRemovedHeaders(cookieHeaders);
        java.util.function.Function<java.util.List<String>, burp.api.montoya.http.message.requests.HttpRequest> build = values -> {
            if (values.isEmpty()) return withoutCookies;
            return withoutCookies.withAddedHeader(burp.api.montoya.http.message.HttpHeader.httpHeader("Cookie", String.join("; ", values)));
        };
        // Confirm that consolidating Cookie headers preserves the baseline before reducing.
        current = build.apply(cookies);
        if (!cookies.isEmpty() && !equivalent.test(api.http().sendRequest(current).response())) {
            logging.logToOutput("Inconclusive: consolidating Cookie headers changed the response. No request exported."); return;
        }
        for (String name : names) {
            // Duplicate cookie names are tested as one group to avoid redundant copies masking a requirement.
            var remaining = new java.util.ArrayList<String>(cookies);
            remaining.removeIf(cookie -> cookie.split("=", 2)[0].equals(name));
            try {
                var candidate = build.apply(remaining);
                var deletionResponse = api.http().sendRequest(candidate).response();
                if (deletionResponse == null) {
                    inconclusive++;
                    logging.logToOutput("[Cookie " + name + "] Inconclusive: no response without cookie; original value retained."); continue;
                }
                if (equivalent.test(deletionResponse)) {
                    current = candidate;
                    cookies = remaining;
                    deleted++;
                    logging.logToOutput("[Cookie " + name + "] Not required in this reduction: removed.");
                    continue;
                }
                var modified = new java.util.ArrayList<String>(cookies);
                // Use 'b' when all original occurrences already equal 'a', so the value actually changes.
                boolean alreadyA = true;
                for (String cookie : cookies) {
                    var parts = cookie.split("=", 2);
                    if (parts[0].equals(name) && (parts.length != 2 || !parts[1].equals("a"))) alreadyA = false;
                }
                String testValue = alreadyA ? "b" : "a";
                for (int i = 0; i < modified.size(); i++) {
                    if (modified.get(i).split("=", 2)[0].equals(name)) modified.set(i, name + "=" + testValue);
                }
                candidate = build.apply(modified);
                var modifiedResponse = api.http().sendRequest(candidate).response();
                if (modifiedResponse == null) {
                    inconclusive++;
                    logging.logToOutput("[Cookie " + name + "] Presence required; value test inconclusive (no response). Original retained.");
                } else if (equivalent.test(modifiedResponse)) {
                    current = candidate;
                    cookies = modified;
                    replaceable++;
                    logging.logToOutput("[Cookie " + name + "] Presence required; replacement value '" + testValue + "' accepted and retained.");
                } else {
                    valueSensitive++;
                    logging.logToOutput("[Cookie " + name + "] Presence required; replacement value '" + testValue + "' changes the response. Original retained (value-sensitive).");
                }
            } catch (Exception e) {
                inconclusive++;
                logging.logToOutput("[Cookie " + name + "] Inconclusive: probe error (" + e.getClass().getSimpleName() + "); previous value retained.");
            }
        }
        if (!equivalent.test(api.http().sendRequest(current).response())
            || !equivalent.test(api.http().sendRequest(original).response())) {
            logging.logToOutput("Inconclusive: final validation failed. No reduced request exported.");
            return;
        }
        api.repeater().sendToRepeater(current, "Relevant Headers - reduced");
        logging.logToOutput("Removed=" + deleted + " | replacement accepted=" + replaceable
            + " | value-sensitive=" + valueSensitive + " | inconclusive=" + inconclusive);
        logging.logToOutput("Validated reduced request sent to a new Repeater tab, including accepted header/cookie replacement values. Greedy reduction; global minimum not guaranteed.");
        logging.logToOutput("Accepting one replacement does not prove all values are accepted; rejecting it does not prove secure validation. Disable session rules or extensions that restore headers/cookies before testing.");
    } catch (Exception e) {
        logging.logToOutput("Inconclusive: " + e.getClass().getSimpleName());
    }
