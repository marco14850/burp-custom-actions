name: Web Cache Deception
function: CUSTOM_ACTION
location: REPEATER
source: |+
    logging.logToOutput("=== Web Cache Deception: controlled candidate discovery ===");
    // Keep patterns specific. Empty patterns require an exact body match.
    String volatilePattern = "";
    // Optional regex for private content. If present, capture group 1 (or the full match)
    // is compared across responses. Select user-specific content, never generic page text.
    String sensitivePattern = "";
    // Extend with every application-specific credential header, in lowercase.
    var credentialHeaders = java.util.Set.of("authorization", "proxy-authorization", "cookie",
        "x-api-key", "api-key", "x-auth-token", "x-access-token", "x-csrf-token", "x-xsrf-token");
    // Prevent browser reload/conditional headers from bypassing or obscuring cache tests.
    boolean removeCacheBypassHeaders = true;
    // Adds a unique query parameter while retaining all original query parameters.
    // Isolation depends on the actual cache key; some caches ignore query parameters.
    boolean addCacheBuster = true;
    String cacheBusterName = "__wcd";
    String[] delimiters = new String[] {"/", ";", "%2F", "%3B", "%3F", "%23", "%00"};
    String[] extensions = new String[] {".css", ".js", ".jpg", ".png", ".ico", ".svg"};
    // Customize these to directories/file names actually used by the target cache.
    String[] staticDirectories = new String[] {"assets", "static", "resources"};
    String[] staticFiles = new String[] {"robots.txt", "favicon.ico"};
    var original = requestResponse.request();
    if (!original.method().equals("GET") || original.httpService() == null) {
        logging.logToOutput("Select a valid HTTP GET request in Repeater."); return;
    }
    String path = original.path();
    int queryIndex = path.indexOf('?');
    String query = queryIndex < 0 ? "" : path.substring(queryIndex);
    String basePath = queryIndex < 0 ? path : path.substring(0, queryIndex);
    if (!basePath.startsWith("/")) { logging.logToOutput("Invalid request path. Expected a path starting with '/'."); return; }
    logging.logToOutput("Anonymous checks remove headers only; verify other credentials.");
    try {
        var volatileRegex = volatilePattern.isEmpty() ? null : java.util.regex.Pattern.compile(volatilePattern);
        var privateRegex = sensitivePattern.isEmpty() ? null : java.util.regex.Pattern.compile(sensitivePattern);
        java.util.function.Function<HttpResponse, String> fingerprint = response -> {
            String body = response.bodyToString();
            if (privateRegex != null) {
                var matcher = privateRegex.matcher(body);
                var values = new java.util.ArrayList<String>();
                while (matcher.find()) {
                    String value = matcher.groupCount() > 0 ? matcher.group(1) : matcher.group();
                    if (value != null && !value.isEmpty()) values.add(value.length() + ":" + value);
                }
                return values.isEmpty() ? null : String.join("|", values);
            }
            return volatileRegex == null ? body : volatileRegex.matcher(body).replaceAll("<volatile>");
        };
        var bypassHeaders = java.util.Set.of("cache-control", "pragma", "if-none-match", "if-modified-since",
            "if-match", "if-unmodified-since", "if-range", "range");
        var bypassRemoved = new java.util.ArrayList<burp.api.montoya.http.message.HttpHeader>();
        if (removeCacheBypassHeaders) {
            for (var header : original.headers()) {
                if (bypassHeaders.contains(header.name().toLowerCase(java.util.Locale.ROOT))) bypassRemoved.add(header);
            }
        }
        var prepared = original.withRemovedHeaders(bypassRemoved);
        java.util.function.Function<burp.api.montoya.http.message.requests.HttpRequest,
            burp.api.montoya.http.message.requests.HttpRequest> anonymize = request -> {
            var removed = new java.util.ArrayList<burp.api.montoya.http.message.HttpHeader>();
            for (var header : request.headers()) {
                if (credentialHeaders.contains(header.name().toLowerCase(java.util.Locale.ROOT))) removed.add(header);
            }
            return request.withRemovedHeaders(removed);
        };
        var baseline = api.http().sendRequest(prepared).response();
        var control = api.http().sendRequest(prepared).response();
        if (baseline == null || control == null || baseline.statusCode() != 200 || baseline.body().length() == 0) {
            logging.logToOutput("Inconclusive: require a nonempty 200 baseline and available controls."); return;
        }
        String baselineFingerprint = fingerprint.apply(baseline);
        if (baselineFingerprint == null || baselineFingerprint.isEmpty()) {
            logging.logToOutput("Inconclusive: comparison pattern found no nonempty private content in baseline."); return;
        }
        java.util.function.Predicate<HttpResponse> matches = response -> response != null
            && response.statusCode() == baseline.statusCode()
            && java.util.Objects.equals(response.headerValue("Content-Type"), baseline.headerValue("Content-Type"))
            && java.util.Objects.equals(response.headerValue("Location"), baseline.headerValue("Location"))
            && baselineFingerprint.equals(fingerprint.apply(response));
        if (!matches.test(control)) {
            logging.logToOutput("Inconclusive: unstable baseline. Configure volatilePattern or a specific sensitivePattern."); return;
        }
        var anonymousBaseline = api.http().sendRequest(anonymize.apply(prepared)).response();
        if (anonymousBaseline == null || matches.test(anonymousBaseline)) {
            logging.logToOutput("Inconclusive: original resource is already accessible anonymously."); return;
        }
        java.util.function.Predicate<HttpResponse> cacheEvidence = response -> {
            for (var header : response.headers()) {
                if (header.name().equalsIgnoreCase("Age")) {
                    try { if (Long.parseLong(header.value().trim()) > 0) return true; }
                    catch (NumberFormatException ignored) { }
                }
                String name = header.name().toLowerCase(java.util.Locale.ROOT);
                if (java.util.Set.of("x-cache", "cf-cache-status", "x-cache-status", "cache-status").contains(name)
                    && java.util.regex.Pattern.compile("(?i)(?:^|[\\s,;])(?:HIT|TCP_HIT)(?:$|[\\s,;])").matcher(header.value()).find()) return true;
            }
            return false;
        };
        // Directives are observations, never a reason to skip a potentially misconfigured cache.
        java.util.function.Function<HttpResponse, String> cacheControl = response -> {
            var values = new java.util.ArrayList<String>();
            for (var header : response.headers()) {
                if (header.name().equalsIgnoreCase("Cache-Control")) values.add(header.value());
            }
            return values.isEmpty() ? "(absent)" : String.join(", ", values).replaceAll("[\\r\\n]", " ");
        };
        var templates = new java.util.LinkedHashMap<String, String>();
        for (String delimiter : delimiters) {
            for (String extension : extensions) {
                templates.put("suffix " + delimiter + " " + extension, basePath + delimiter + "{id}" + extension);
            }
        }
        String resource = basePath.substring(1);
        for (String directory : staticDirectories) {
            // Cache sees a static directory; the origin may decode and resolve the traversal.
            templates.put("origin normalization " + directory, "/" + directory + "/{id}/..%2f..%2f" + resource);
            // The cache may resolve traversal while the origin retains the dynamic resource.
            templates.put("cache normalization " + directory, basePath + "%2f%2e%2e%2f" + directory + "/{id}.css");
            templates.put("delimiter normalization " + directory, basePath + "%23%2f%2e%2e%2f" + directory + "/{id}.css");
        }
        for (String file : staticFiles) {
            // Exact file-name rules need a query buster; do not run these without one.
            if (addCacheBuster) templates.put("file normalization " + file, basePath + "%23%2f%2e%2e%2f" + file);
        }
        int candidates = 0;
        int supported = 0;
        int accessibleBefore = 0;
        int noObservedExposure = 0;
        int inconclusive = 0;
        int tested = 0;
        logging.logToOutput("Variants: " + templates.size() + " | comparison=" + (privateRegex == null ? "normalized full body" : "private-content regex"));
        for (var entry : templates.entrySet()) {
            String marker = "wcd-" + java.util.UUID.randomUUID();
            String probeQuery = query;
            if (addCacheBuster) probeQuery += (query.isEmpty() ? "?" : "&") + cacheBusterName + "=" + marker;
            var candidate = prepared.withPath(entry.getValue().replace("{id}", marker) + probeQuery);
            var anonymous = anonymize.apply(candidate);
            tested++;
            try {
                // Check this exact candidate before priming to separate pre-existing exposure.
                var before = api.http().sendRequest(anonymous).response();
                if (before == null) {
                    inconclusive++;
                    logging.logToOutput("[" + entry.getKey() + "] Inconclusive: anonymous pre-control unavailable."); continue;
                }
                if (matches.test(before)) {
                    accessibleBefore++;
                    logging.logToOutput("[" + entry.getKey() + "] Private content was accessible before cache priming: " + candidate.url()); continue;
                }
                var authenticated = api.http().sendRequest(candidate).response();
                String preControl = "exact URL nonmatch";
                if (authenticated == null) {
                    inconclusive++;
                    logging.logToOutput("[" + entry.getKey() + "] Inconclusive: authenticated variant unavailable."); continue;
                }
                if (!matches.test(authenticated)) {
                    // A cached anonymous rejection can mask a valid route. Retry once with
                    // authenticated-first ordering on a fresh URL; attribution is weaker.
                    String retryMarker = "wcd-" + java.util.UUID.randomUUID();
                    String retryQuery = query;
                    if (addCacheBuster) retryQuery += (query.isEmpty() ? "?" : "&") + cacheBusterName + "=" + retryMarker;
                    candidate = prepared.withPath(entry.getValue().replace("{id}", retryMarker) + retryQuery);
                    anonymous = anonymize.apply(candidate);
                    authenticated = api.http().sendRequest(candidate).response();
                    preControl = "sibling nonmatch; fresh URL primed first (weaker attribution)";
                    logging.logToOutput("[" + entry.getKey() + "] Retried authenticated-first on a fresh URL to avoid a cached anonymous rejection.");
                    if (authenticated == null || !matches.test(authenticated)) {
                        inconclusive++;
                        logging.logToOutput("[" + entry.getKey() + "] Inconclusive: authenticated variant does not reproduce private baseline after retry."); continue;
                    }
                }
                var retrieved = api.http().sendRequest(anonymous).response();
                var repeated = api.http().sendRequest(anonymous).response();
                if (retrieved == null || repeated == null) {
                    inconclusive++;
                    logging.logToOutput("[" + entry.getKey() + "] Inconclusive: anonymous retrieval unavailable."); continue;
                }
                if (!matches.test(retrieved) || !matches.test(repeated)) {
                    if (matches.test(retrieved) || matches.test(repeated)) {
                        inconclusive++;
                        logging.logToOutput("[" + entry.getKey() + "] Inconclusive: private content not reproducible across both anonymous reads.");
                    } else {
                        noObservedExposure++;
                        logging.logToOutput("[" + entry.getKey() + "] No private exposure observed after priming.");
                    }
                    continue;
                }
                // A fresh unprimed sibling helps detect wildcard authorization bypasses or key collisions.
                String witnessMarker = "wcd-" + java.util.UUID.randomUUID();
                String witnessQuery = query;
                if (addCacheBuster) witnessQuery += (query.isEmpty() ? "?" : "&") + cacheBusterName + "=" + witnessMarker;
                var witness = prepared.withPath(entry.getValue().replace("{id}", witnessMarker) + witnessQuery);
                var witnessResponse = api.http().sendRequest(anonymize.apply(witness)).response();
                var freshBaseline = api.http().sendRequest(prepared).response();
                if (witnessResponse == null || !matches.test(freshBaseline) || matches.test(witnessResponse)) {
                    inconclusive++;
                    logging.logToOutput("[" + entry.getKey() + "] Exposure observed but attribution inconclusive: unprimed sibling also matches, control failed or baseline changed. URL: " + candidate.url()); continue;
                }
                boolean evidence = cacheEvidence.test(retrieved) || cacheEvidence.test(repeated);
                candidates++;
                if (evidence) supported++;
                logging.logToOutput("[" + entry.getKey() + "] Unconfirmed candidate: " + candidate.url()
                    + " | pre-control=" + preControl + " | anonymous after=2 matches | unprimed sibling=nonmatch"
                    + " | cache evidence=" + evidence + " | authenticated Cache-Control=" + cacheControl.apply(authenticated)
                    + " | anonymous Cache-Control=" + cacheControl.apply(repeated));
            } catch (Exception e) {
                inconclusive++;
                logging.logToOutput("[" + entry.getKey() + "] Inconclusive: " + e.getClass().getSimpleName());
            }
        }
        logging.logToOutput("URLs tested: " + tested
    + " | Potential findings: " + candidates
    + " | Cache indicators: " + supported
    + " | Already accessible: " + accessibleBefore
    + " | No exposure observed: " + noObservedExposure
    + " | Inconclusive: " + inconclusive);
        logging.logToOutput("Candidates require manual confirmation of shared-cache origin and persistence. Zero candidates does not exclude deception. Inspect Logger; no Repeater tabs created.");
    } catch (Exception e) {
        logging.logToOutput("Inconclusive: " + e.getClass().getSimpleName());
    }
