name: Selected String Analyzer
function: CUSTOM_ACTION
location: REPEATER
source: |+
    logging.logToOutput("=== CA: Selected String Analyzer ===");
    if (!selection.hasResponseSelection()) { logging().logToOutput("Select text in the response first."); return; }
    var text = selection.responseSelection().contents().toString().strip();
    if (text.isEmpty()) { logging().logToOutput("Select text in the response first."); return; }
    boolean found = false;
    // Hash-specific identification lives in Hash Identifier.
    var compact = text.replaceAll("\\s", "");
    if (compact.length() >= 4 && compact.length() % 4 == 0 && compact.matches("[A-Za-z0-9+/]+={0,2}")) {
        try {
            var decoded = java.util.Base64.getDecoder().decode(compact);
            if (java.util.Base64.getEncoder().encodeToString(decoded).equals(compact)) {
                logging().logToOutput("Possible canonical Base64; decoded bytes: " + decoded.length);
                found = true;
            }
        } catch (IllegalArgumentException ignored) { }
    }
    if (compact.matches("[01]{8,}") && compact.length() % 8 == 0) {
        logging().logToOutput("Possible binary data (whole bytes)."); found = true;
    }
    if (text.matches("[0-9]{12,19}")) {
        int sum = 0;
        boolean doubleDigit = false;
        for (int i = text.length() - 1; i >= 0; i--) {
            int digit = text.charAt(i) - '0';
            if (doubleDigit) { digit *= 2; if (digit > 9) digit -= 9; }
            sum += digit; doubleDigit = !doubleDigit;
        }
        logging().logToOutput(sum % 10 == 0 ? "Luhn passed (does not establish a real or issued card)." : "Luhn failed.");
        if (sum % 10 != 0 && text.length() < 19) {
            int prefixSum = 0;
            boolean doublePrefixDigit = true;
            for (int i = text.length() - 1; i >= 0; i--) {
                int digit = text.charAt(i) - '0';
                if (doublePrefixDigit) { digit *= 2; if (digit > 9) digit -= 9; }
                prefixSum += digit; doublePrefixDigit = !doublePrefixDigit;
            }
            logging().logToOutput("Check digit if treated as a prefix: " + ((10 - prefixSum % 10) % 10));
        }
        found = true;
    }
    if (!found) logging().logToOutput("Text or unsupported format. Use Hash Identifier for hashes.");
